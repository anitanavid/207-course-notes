
@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}

interface Borrowable {
  + borrow() : void
  + returnItem() : void
}

class Book {
  - author : String
  - loanPeriod : int
}

class DVD {
  - duration : int
  - loanPeriod : int
}

class ReferenceItem {
  - location : String
}

abstract class Person {
  - name : String
  - id : String
}

class Member {
  + borrowItem(item : Borrowable) : void
  + placeHold(item : Item) : void
}

class Librarian {
  + addItem(item : Item) : void
  + removeItem(item : Item) : void
}

class Hold {
  - holdDate : String
  - status : String
}

Item <|-- Book
Item <|-- DVD
Item <|-- ReferenceItem

Borrowable <|.. Book
Borrowable <|.. DVD

Person <|-- Member
Person <|-- Librarian

Member "1" -- "0..*" Hold : places
Item "1" -- "0..*" Hold : reserved for

@enduml
